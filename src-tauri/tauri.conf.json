{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlock BCMA",
  "version": "0.3.0",
  "identifier": "com.empera.deadlockstatcalculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deadlock BCMA",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "empera",
    "shortDescription": "Deadlock BCMA: build calculator and match analysis",
    "longDescription": "Builds, combos and match analysis for Deadlock, computed from the game's own data.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2MjU2QTQ5M0NCMzEzOUUKUldTZUU3TThTV29sdG9rYnE1aE8ycjNzWnpTUnRmMGFIcGVYbmVIaFpwaDhqQ0xNSnE5VEk2OEEK",
      "endpoints": [
        "https://github.com/Empera0/Deadlock-BCMA/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
